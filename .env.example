# URL Explorer — configuración
# Copia este fichero a .env y ajusta lo que necesites.
# Todos los valores tienen un valor por defecto en src/config/index.js.

# ── Servidor ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Peticiones HTTP salientes ────────────────────────────────────────
HTTP_PAGE_TIMEOUT_MS=8000
HTTP_FILE_SCAN_TIMEOUT_MS=8000
HTTP_HEAD_TIMEOUT_MS=5000
HTTP_MAX_REDIRECTS=5
# Tope de bytes por respuesta: evita que una página enorme agote la RAM
HTTP_MAX_RESPONSE_BYTES=10485760
HTTP_RETRIES=3
HTTP_RETRY_BASE_DELAY_MS=1000
# Espera propia para el 429: el backoff lineal de arriba reintenta DENTRO del
# bloqueo, y un rate-limit por volumen tarda minutos en levantarse. Si el sitio
# manda Retry-After (segundos o fecha HTTP) manda esa cabecera, siempre
# recortada por el maximo: uno de una hora colgaria el crawl entero.
HTTP_RETRY_429_BASE_DELAY_MS=5000
HTTP_RETRY_429_MAX_DELAY_MS=30000

# ── Límites del crawl ────────────────────────────────────────────────
CRAWL_MAX_PAGES=50
# Direcciones máximas por lote (exploración multi-URL). Cada dirección es un
# crawl completo: el tope acota el trabajo total de una sola petición.
CRAWL_MAX_URLS=10
CRAWL_MAX_LINKS=5000
CRAWL_MAX_FILES=5000
CRAWL_DEFAULT_CONCURRENCY=4
CRAWL_MAX_CONCURRENCY=12
CRAWL_PAGE_DELAY_MS=500
CRAWL_MAX_DURATION_MS=600000

# ── Throttling por dominio ───────────────────────────────────────────
THROTTLE_MIN_INTERVAL_MS=250
THROTTLE_MAX_CONCURRENT_PER_HOST=4
# Freno reactivo por host: tras N respuestas 429 seguidas, el intervalo minimo
# de ESE host se multiplica por el factor (con tope) durante el enfriamiento.
# El resto de hosts no se ve afectado. 120000 ms es la recuperacion real medida
# sobre un sitio que bloquea por volumen.
THROTTLE_CIRCUIT_BREAKER_THRESHOLD=5
THROTTLE_CIRCUIT_BREAKER_FACTOR=8
THROTTLE_CIRCUIT_BREAKER_MAX_MS=5000
THROTTLE_CIRCUIT_BREAKER_COOLDOWN_MS=120000

# ── Navegador (Puppeteer) ────────────────────────────────────────────
BROWSER_ENABLED=true
BROWSER_POOL_SIZE=2
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_SETTLE_MS=2500
BROWSER_SCROLL_STEP_PX=500
BROWSER_MAX_SCROLL_PX=10000
BROWSER_IDLE_SHUTDOWN_MS=60000

# ── Seguridad ────────────────────────────────────────────────────────
# Bloquea loopback, redes privadas, link-local (169.254.x) y multicast.
# Desactivar SOLO para pruebas contra fixtures locales. NUNCA en producción.
SECURITY_BLOCK_PRIVATE_ADDRESSES=true
SECURITY_ALLOWED_PROTOCOLS=http:,https:
# Allowlist opcional de hosts. Vacía = cualquier host público.
# Admite comodín de subdominio: ejemplo.com,*.ejemplo.org
SECURITY_ALLOWED_HOSTS=
SECURITY_MAX_URL_LENGTH=2048
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ── Modo admin ───────────────────────────────────────────────────────
# Token que desbloquea las configuraciones guardadas. Ponlo SOLO en tu .env
# local, nunca aquí ni en ningún fichero versionado.
# Si se deja vacío, el modo admin queda deshabilitado: la aplicación funciona
# igual, pero sin configuraciones guardadas para nadie, y las rutas
# /api/admin/* responden 404.
ADMIN_TOKEN=
# Fichero donde se guardan las configuraciones. El directorio data/ está en
# .gitignore: es lo que mantiene los sitios fuera del repositorio.
ADMIN_PROFILES_PATH=
# Rate limiting del desbloqueo: mucho más estricto que el general, porque es
# el único endpoint donde la fuerza bruta tiene sentido.
ADMIN_UNLOCK_WINDOW_MS=60000
ADMIN_UNLOCK_MAX_ATTEMPTS=5
ADMIN_MAX_PROFILES=100

# ── Extracción de video ──────────────────────────────────────────────
VIDEO_MAX_METADATA_LOOKUPS=100
VIDEO_MAX_RESULTS=500

# ── Progreso en tiempo real (SSE) ────────────────────────────────────
# Comentario periodico que mantiene abierta la conexion de progreso: un proxy
# sin datos que reenviar la cierra, y un analisis con navegador puede pasar
# minutos sin emitir nada.
SSE_HEARTBEAT_MS=15000

# ── Confianza en proxies ─────────────────────────────────────────────
# De quién se acepta X-Forwarded-For. NUNCA "true": significa "confía en
# cualquiera", y como el rate limiting va por req.ip, un cliente que rote esa
# cabecera se salta el límite entero — incluida la protección de fuerza bruta
# del desbloqueo de admin. Detrás de un proxy inverso, poner SU dirección.
# 'loopback' NO vale en este despliegue: los clientes conectan desde localhost.
TRUST_PROXY=false

# Peticiones de peso simultáneas al extraer vídeos de una página. Sustituye a
# la pausa fija que había: la cortesía por dominio ya la impone el throttle.
VIDEO_METADATA_CONCURRENCY=4

# ── Miniaturas ───────────────────────────────────────────────────────
# Las sirve el BACKEND, nunca el navegador del usuario: si el <img> apuntara
# al CDN del sitio explorado, cada miniatura revelaría la IP del usuario a
# terceros y obligaría a abrir la CSP (img-src). Ver services/thumbnails.js.
THUMBNAILS_ENABLED=true
THUMBNAILS_TIMEOUT_MS=6000
THUMBNAILS_MAX_BYTES=2097152
# Caché EN MEMORIA: muere con el proceso y no deja rastro en disco
THUMBNAILS_CACHE_MAX_ENTRIES=300
THUMBNAILS_CACHE_MAX_BYTES=67108864
THUMBNAILS_BROWSER_CACHE_SECONDS=3600
# Limite PROPIO de las miniaturas, mucho mas alto que el general de /api: una
# sola lista de resultados necesita decenas, y compartiendo el limite de 30/min
# las primeras cargaban y el resto salia como imagen rota.
THUMBNAILS_RATE_WINDOW_MS=60000
THUMBNAILS_RATE_MAX=600

# ── Exploraciones frenadas a medias ──────────────────────────────────
# EN MEMORIA: si el proceso se reinicia, lo pendiente se pierde. Es el precio
# de no persistir (los resultados llevan nombres de sitios) y esta elegido.
JOBS_TTL_MS=1800000
JOBS_MAX=20
