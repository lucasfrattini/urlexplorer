# URL Explorer — configuración
# Copia este fichero a .env y ajusta lo que necesites.
# Todos los valores tienen un valor por defecto en src/config/index.js.

# ── Servidor ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Peticiones HTTP salientes ────────────────────────────────────────
HTTP_PAGE_TIMEOUT_MS=8000
HTTP_FILE_SCAN_TIMEOUT_MS=8000
HTTP_HEAD_TIMEOUT_MS=5000
HTTP_MAX_REDIRECTS=5
# Tope de bytes por respuesta: evita que una página enorme agote la RAM
HTTP_MAX_RESPONSE_BYTES=10485760
HTTP_RETRIES=3
HTTP_RETRY_BASE_DELAY_MS=1000

# ── Límites del crawl ────────────────────────────────────────────────
CRAWL_MAX_PAGES=50
CRAWL_MAX_LINKS=5000
CRAWL_MAX_FILES=5000
CRAWL_DEFAULT_CONCURRENCY=4
CRAWL_MAX_CONCURRENCY=12
CRAWL_PAGE_DELAY_MS=500
CRAWL_MAX_DURATION_MS=600000

# ── Throttling por dominio ───────────────────────────────────────────
THROTTLE_MIN_INTERVAL_MS=250
THROTTLE_MAX_CONCURRENT_PER_HOST=4

# ── Navegador (Puppeteer) ────────────────────────────────────────────
BROWSER_ENABLED=true
BROWSER_POOL_SIZE=2
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_SETTLE_MS=2500
BROWSER_SCROLL_STEP_PX=500
BROWSER_MAX_SCROLL_PX=10000
BROWSER_IDLE_SHUTDOWN_MS=60000

# ── Seguridad ────────────────────────────────────────────────────────
# Bloquea loopback, redes privadas, link-local (169.254.x) y multicast.
# Desactivar SOLO para pruebas contra fixtures locales. NUNCA en producción.
SECURITY_BLOCK_PRIVATE_ADDRESSES=true
SECURITY_ALLOWED_PROTOCOLS=http:,https:
# Allowlist opcional de hosts. Vacía = cualquier host público.
# Admite comodín de subdominio: ejemplo.com,*.ejemplo.org
SECURITY_ALLOWED_HOSTS=
SECURITY_MAX_URL_LENGTH=2048
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ── Modo admin ───────────────────────────────────────────────────────
# Token que desbloquea las configuraciones guardadas. Ponlo SOLO en tu .env
# local, nunca aquí ni en ningún fichero versionado.
# Si se deja vacío, el modo admin queda deshabilitado: la aplicación funciona
# igual, pero sin configuraciones guardadas para nadie, y las rutas
# /api/admin/* responden 404.
ADMIN_TOKEN=
# Fichero donde se guardan las configuraciones. El directorio data/ está en
# .gitignore: es lo que mantiene los sitios fuera del repositorio.
ADMIN_PROFILES_PATH=
# Rate limiting del desbloqueo: mucho más estricto que el general, porque es
# el único endpoint donde la fuerza bruta tiene sentido.
ADMIN_UNLOCK_WINDOW_MS=60000
ADMIN_UNLOCK_MAX_ATTEMPTS=5
ADMIN_MAX_PROFILES=100

# ── Extracción de video ──────────────────────────────────────────────
VIDEO_METADATA_DELAY_MS=300
VIDEO_MAX_METADATA_LOOKUPS=100
VIDEO_MAX_RESULTS=500
