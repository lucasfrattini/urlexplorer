{
  "name": "url-explorer",
  "version": "2.0.0",
  "description": "URL Explorer — explora los enlaces y recursos multimedia de un sitio web recorriendo su paginación.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "puppeteer": "^24.19.0"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.3.3"
  },
  "keywords": [
    "scraping",
    "web",
    "links",
    "express",
    "node",
    "url-explorer"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
